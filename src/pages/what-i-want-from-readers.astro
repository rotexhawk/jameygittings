---
import Page from "../layouts/Page.astro";
import redwoods from "../assets/images/redwood-background.jpeg";

const traits = [
  "Someone who is uncomfortable with the comfortable; someone who is suspicious of routine; with things as they are usually done.",
  "People who cherish the ability to think differently; to approach things from an oblique perspective — who don’t trust anyone over the age of 11 months.",
  "Persons who are intrepid. Those with the ability — willingly or haltingly — to assume and cope with risk. People who value those who overcome, act, and rise above, the condition of fear.",
];
---

<Page
  title="What I Want From Readers"
  description="Rather than tailoring fiction to an audience, novelist Jamey Gittings describes the readers he hopes to find."
  eyebrow="For readers"
  heading="What I want <em>from</em> readers"
  image={redwoods}
  imagePosition="50% 60%"
>
  <section class="section">
    <div class="narrow" data-reveal>
      <figure class="pull lead-pull" data-reveal>
        <blockquote>
          <p>Readers who bring with them an attitude, and don’t mind a writer who does the same.</p>
        </blockquote>
      </figure>

      <ul class="traits">
        {traits.map(t => <li data-reveal>{t}</li>)}
      </ul>

      <figure class="pull" data-reveal>
        <blockquote>
          <p>
            People who look failure in the eye and say, “Let’s walk in backwards, and pretend we’re just leaving.”
          </p>
        </blockquote>
      </figure>
    </div>
  </section>
</Page>

<style>
  .traits {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .traits li {
    position: relative;
    padding-left: 2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .traits li::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0.1em;
    font-size: 0.8em;
    color: var(--accent);
  }

  .pull {
    margin: 4rem 0;
    padding: 2.5rem 0;
    border-block: 1px solid var(--rule-strong);
    text-align: center;
  }

  .lead-pull {
    margin-top: 0;
  }

  .pull blockquote {
    margin: 0;
  }

  .pull p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.3;
    margin: 0;
    color: var(--accent);
  }
</style>
