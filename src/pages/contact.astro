---
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";
import redwoods from "../assets/images/redwood-background.jpeg";

// Turnstile site key (public). The secret lives only in the Worker (TURNSTILE_SECRET_KEY).
const TURNSTILE_SITE_KEY = "0x4AAAAAAFOxr8Gex_oJ5Qm0";
---

<Page
  title="Contact"
  description="Get in touch with novelist Jamey Gittings."
  eyebrow="Correspondence"
  heading="Write to <em>Jamey</em>"
  image={redwoods}
  imagePosition="50% 40%"
>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <section class="section">
    <div class="container contact-grid">
      <div class="aside" data-reveal>
        <p class="lead">
          Readers, reviewers, book clubs and booksellers are welcome. Send a note and Jamey will write back.
        </p>
        <a class="mail" href="mailto:jameygittings@gmail.com">
          <Icon name="mail" />
          jameygittings@gmail.com
        </a>
      </div>

      <form class="form" method="POST" action="/api/contact" novalidate data-contact>
        <p class="visually-hidden" aria-hidden="true">
          <label>Don’t fill this out if you’re human: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" />
          <p class="error" id="name-error" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            aria-describedby="email-error"
          />
          <p class="error" id="email-error" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="7" required aria-describedby="message-error"></textarea>
          <p class="error" id="message-error" aria-live="polite"></p>
        </div>

        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto"></div>

        <div class="submit-row">
          <p class="fine">Protected against spam by Cloudflare Turnstile.</p>
          <button class="btn btn-primary" type="submit" data-submit>
            <span data-label>Send message</span>
            <Icon name="arrow-right" />
          </button>
        </div>

        <div class="status" role="status" aria-live="polite" data-status hidden></div>
      </form>
    </div>
  </section>
</Page>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .aside .lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 2rem;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .mail :global(svg) {
    width: 20px;
    height: 20px;
  }

  .form {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
  }

  input,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  [aria-invalid="true"] {
    border-color: #b42318;
  }

  .error {
    min-height: 1.2em;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: #b42318;
  }

  :global([data-theme="dark"]) .error,
  :global([data-theme="dark"]) [aria-invalid="true"] {
    color: #ff9b8f;
    border-color: #ff9b8f;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .error {
      color: #ff9b8f;
    }
    :global(:root:not([data-theme="light"])) [aria-invalid="true"] {
      border-color: #ff9b8f;
    }
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .fine {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
  }

  button[aria-busy="true"] {
    opacity: 0.75;
    cursor: progress;
  }

  .status {
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
  }

  .status.ok {
    border-color: #3f7a4a;
  }

  .status.err {
    border-color: #b42318;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type Turnstile = { reset: () => void };
  const turnstile = () => (window as unknown as { turnstile?: Turnstile }).turnstile;

  const form = document.querySelector<HTMLFormElement>("[data-contact]");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const label = form.querySelector<HTMLElement>("[data-label]")!;

    const errors: Record<string, string> = {
      captcha: "Please complete the “I’m not a robot” check, then send again.",
      invalid: "Please fill in your name, a valid email address, and a message.",
      send: "Sorry, your message couldn’t be sent. Please try again, or email jameygittings@gmail.com directly.",
    };

    const messages: Record<string, string> = {
      name: "Please enter your name.",
      email: "Please enter a valid email address.",
      message: "Please write a message.",
    };

    const validate = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const ok = el.value.trim() !== "" && el.checkValidity();
      el.setAttribute("aria-invalid", String(!ok));
      const err = document.getElementById(`${el.id}-error`);
      if (err) err.textContent = ok ? "" : messages[el.name];
      return ok;
    };

    const fields = ["name", "email", "message"].map(
      id => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement
    );
    fields.forEach(el => {
      el.addEventListener("blur", () => el.value && validate(el));
      el.addEventListener("input", () => el.getAttribute("aria-invalid") === "true" && validate(el));
    });

    const showStatus = (text: string, kind: "ok" | "err") => {
      status.hidden = false;
      status.className = `status ${kind}`;
      status.textContent = text;
    };

    // No-JS fallback: the Worker redirects back here with ?sent=1 or ?error=<code>
    const params = new URLSearchParams(location.search);
    if (params.get("sent") === "1") showStatus("Thank you — your message has been sent.", "ok");
    else if (params.get("error")) showStatus(errors[params.get("error")!] ?? errors.send, "err");

    form.addEventListener("submit", async e => {
      e.preventDefault();
      const invalid = fields.filter(f => !validate(f));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      label.textContent = "Sending…";
      status.hidden = true;

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (!res.ok || !data.ok) throw new Error(data.error ?? errors.send);
        form.reset();
        fields.forEach(f => f.removeAttribute("aria-invalid"));
        showStatus("Thank you — your message has been sent. Jamey will reply to the email address you gave.", "ok");
      } catch (err) {
        showStatus(err instanceof Error && err.message ? err.message : errors.send, "err");
      } finally {
        turnstile()?.reset();
        button.disabled = false;
        button.removeAttribute("aria-busy");
        label.textContent = "Send message";
      }
    });
  }
</script>
