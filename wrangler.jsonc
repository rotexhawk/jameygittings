{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jameygittings",
  "compatibility_date": "2026-10-01",
  // Redirects the bare domain to www and handles /api/contact; everything else is static assets
  "main": "./worker/index.ts",
  // Static site: Astro builds to dist/, served by Workers static assets
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Cloudflare Email Sending, enabled on notify.jameygittings.com (keeps the root domain's mail untouched)
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_TO": "jameygittings@gmail.com",
    "CONTACT_FROM": "contact@notify.jameygittings.com"
  },
  "observability": { "enabled": true },
  // main deploys here via Workers Builds; other branches get preview URLs
  "routes": [
    { "pattern": "www.jameygittings.com", "custom_domain": true },
    { "pattern": "jameygittings.com", "custom_domain": true },
    { "pattern": "dev.jameygittings.com", "custom_domain": true }
  ]
}
